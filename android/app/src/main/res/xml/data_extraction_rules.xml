<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the logbook (crew ID numbers, catch and GPS records) out of
     Google cloud backup and out of phone-to-phone transfer. Moving the logbook to
     another phone is done with the app's own backup file instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
